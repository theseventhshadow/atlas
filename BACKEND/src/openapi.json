{
  "openapi": "3.0.3",
  "info": {
    "title": "Atlas API (español)",
    "version": "1.0.0"
  },
  "servers": [{ "url": "http://localhost:4451" }],
  "paths": {
    "/autenticacion/login": {
      "post": {
        "summary": "Iniciar sesión",
        "description": "Retorna un token JWT que incluye: usuarioId, nombreUsuario, empresaUsuarioId, empresaId",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre_usuario": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["nombre_usuario", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token JWT con información del usuario y empresa"
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Credenciales inválidas" }
        }
      }
    },
    "/usuarios": {
      "get": {
        "summary": "Listar usuarios",
        "description": "Lista todos los usuarios de la empresa del usuario autenticado.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "No autorizado" }
        }
      },
      "post": {
        "summary": "Crear usuario",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UsuarioCrear" }
            }
          }
        },
        "responses": { "201": { "description": "Creado" } }
      }
    },
    "/usuarios/{id}": {
      "get": {
        "summary": "Obtener usuario",
        "description": "Obtiene la información de un usuario específico, incluyendo su rol en la empresa.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "No autorizado" },
          "404": { "description": "Usuario no encontrado" }
        }
      },
      "put": {
        "summary": "Actualizar usuario",
        "description": "Actualiza la información de un usuario. Puede incluir actualización de rol. No se puede cambiar el rol del único administrador ni el propio rol.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre_usuario": { "type": "string" },
                  "contrasena_hash": { "type": "string" },
                  "correo": { "type": "string" },
                  "rol_id": {
                    "type": "integer",
                    "description": "ID del rol a asignar"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "No se puede cambiar el rol" },
          "401": { "description": "No autorizado" },
          "404": { "description": "Usuario no encontrado" }
        }
      },
      "delete": {
        "summary": "Eliminar usuario",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Usuario eliminado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "404": { "description": "Usuario no encontrado" }
        }
      }
    },
    "/clientes": {
      "get": {
        "summary": "Listar clientes",
        "description": "Lista todos los clientes de la empresa del usuario autenticado.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "No autorizado" }
        }
      },
      "post": {
        "summary": "Crear cliente",
        "description": "Crea un nuevo cliente asociado a la empresa del usuario autenticado.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Cliente" }
            }
          }
        },
        "responses": {
          "201": { "description": "Creado" },
          "401": { "description": "No autorizado" }
        }
      }
    },
    "/clientes/search": {
      "get": {
        "summary": "Buscar clientes por nombre",
        "description": "Busca clientes por nombre (filtrado por empresa del token)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "name",
            "schema": { "type": "string" },
            "description": "Nombre del cliente a buscar"
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "No autorizado" }
        }
      }
    },
    "/clientes/{id}": {
      "get": {
        "summary": "Obtener cliente",
        "description": "Obtiene la información de un cliente específico de la empresa del usuario autenticado.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "No autorizado" },
          "404": { "description": "Cliente no encontrado" }
        }
      },
      "put": {
        "summary": "Actualizar cliente",
        "description": "Actualiza la información de un cliente de la empresa del usuario autenticado.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Cliente" }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "No autorizado" },
          "404": { "description": "Cliente no encontrado" }
        }
      },
      "delete": {
        "summary": "Eliminar cliente",
        "description": "Elimina un cliente de la empresa del usuario autenticado.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Cliente eliminado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "401": { "description": "No autorizado" },
          "404": { "description": "Cliente no encontrado" }
        }
      }
    },
    "/contratos": {
      "get": {
        "summary": "Listar contratos",
        "description": "Lista todos los contratos de la empresa del usuario autenticado.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "No autorizado" }
        }
      },
      "post": {
        "summary": "Crear contrato con archivo(s)",
        "description": "Crea un contrato con uno o más archivos. Se pueden enviar hasta 10 archivos.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "cliente_id": { "type": "integer" },
                  "titulo": { "type": "string" },
                  "descripcion": { "type": "string" },
                  "fecha_inicio": { "type": "string", "format": "date" },
                  "fecha_fin": { "type": "string", "format": "date" },
                  "files": {
                    "type": "array",
                    "items": { "type": "string", "format": "binary" },
                    "description": "Hasta 10 archivos PDF"
                  }
                },
                "required": [
                  "cliente_id",
                  "titulo",
                  "fecha_inicio",
                  "fecha_fin",
                  "files"
                ]
              }
            }
          }
        },
        "responses": { "201": { "description": "Creado" } }
      }
    },
    "/contratos/estados": {
      "get": {
        "summary": "Obtener contratos por estado",
        "description": "Retorna un array con contratos por estado (por_vencer y vencido). Máximo 3 contratos por cada estado, filtrados por empresa del token.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ContratoConEstado"
                  }
                }
              }
            }
          },
          "401": { "description": "No autorizado" }
        }
      }
    },
    "/contratos/dashboard": {
      "get": {
        "summary": "Dashboard con estadísticas de la empresa",
        "description": "Retorna estadísticas de la empresa: total usuarios, total clientes y contratos que vencen en 7, 15 y 30 días.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dashboard"
                }
              }
            }
          },
          "401": { "description": "No autorizado" }
        }
      }
    },
    "/contratos/{id}": {
      "get": {
        "summary": "Obtener contrato",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Contrato no encontrado" }
        }
      },
      "put": {
        "summary": "Actualizar contrato",
        "description": "Actualiza los datos de un contrato. Todos los campos son opcionales. Si se envía un archivo, se agregará como nuevo documento manteniendo el historial.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "cliente_id": { "type": "integer" },
                  "titulo": { "type": "string" },
                  "descripcion": { "type": "string" },
                  "fecha_inicio": { "type": "string", "format": "date" },
                  "fecha_fin": { "type": "string", "format": "date" },
                  "files": {
                    "type": "array",
                    "items": { "type": "string", "format": "binary" },
                    "description": "Hasta 10 archivos PDF. Si se envía, se agregarán como nuevos documentos manteniendo el historial."
                  }
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cliente_id": { "type": "integer" },
                  "titulo": { "type": "string" },
                  "descripcion": { "type": "string" },
                  "fecha_inicio": { "type": "string", "format": "date" },
                  "fecha_fin": { "type": "string", "format": "date" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer" },
                    "cliente_id": { "type": "integer" },
                    "titulo": { "type": "string" },
                    "descripcion": { "type": "string" },
                    "fecha_inicio": { "type": "string", "format": "date" },
                    "fecha_fin": { "type": "string", "format": "date" },
                    "created_at": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "401": { "description": "No autorizado" },
          "404": {
            "description": "Contrato no encontrado o no pertenece a tu empresa"
          }
        }
      },
      "delete": {
        "summary": "Eliminar contrato",
        "description": "Elimina un contrato y todos sus archivos asociados.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Contrato eliminado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "404": { "description": "Contrato no encontrado" }
        }
      }
    },
    "/contratos/{id}/files": {
      "get": {
        "summary": "Listar archivos del contrato",
        "description": "Retorna la lista de todos los archivos asociados a un contrato, ordenados por fecha de creación descendente.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer" },
                      "nombre_archivo": { "type": "string" },
                      "created_at": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "Contrato no encontrado" }
        }
      }
    },
    "/contratos/{id}/file/{fileId}": {
      "get": {
        "summary": "Descargar archivo específico del contrato",
        "description": "Descarga un archivo PDF específico de un contrato por su ID de archivo.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true,
            "description": "ID del contrato"
          },
          {
            "in": "path",
            "name": "fileId",
            "schema": { "type": "integer" },
            "required": true,
            "description": "ID del archivo"
          }
        ],
        "responses": {
          "200": {
            "description": "Archivo PDF",
            "content": {
              "application/pdf": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "401": { "description": "No autorizado" },
          "404": { "description": "Archivo no encontrado" }
        }
      },
      "delete": {
        "summary": "Eliminar archivo específico del contrato",
        "description": "Elimina un archivo específico de un contrato. Requiere autenticación y que el contrato pertenezca a la empresa del usuario.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true,
            "description": "ID del contrato"
          },
          {
            "in": "path",
            "name": "fileId",
            "schema": { "type": "integer" },
            "required": true,
            "description": "ID del archivo"
          }
        ],
        "responses": {
          "200": {
            "description": "Archivo eliminado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "401": { "description": "No autorizado" },
          "404": { "description": "Contrato o archivo no encontrado" }
        }
      }
    },
    "/contratos/{id}/file": {
      "get": {
        "summary": "Ver último archivo PDF del contrato",
        "description": "Endpoint legacy que retorna el último archivo subido del contrato (para compatibilidad).",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Archivo PDF",
            "content": {
              "application/pdf": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "404": { "description": "Archivo no encontrado" }
        }
      }
    },
    "/contratos/{id}/share": {
      "post": {
        "summary": "Generar enlace compartido para contrato",
        "description": "Genera un enlace compartido con contraseña para acceder al contrato de forma pública. La contraseña debe tener al menos 4 caracteres.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "password": {
                    "type": "string",
                    "minLength": 4,
                    "description": "Contraseña para acceder al contrato compartido (mínimo 4 caracteres)"
                  }
                },
                "required": ["password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Enlace compartido generado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "shareUrl": { "type": "string", "format": "uri" },
                    "shareToken": { "type": "string" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Contraseña inválida" },
          "401": { "description": "No autorizado" },
          "404": {
            "description": "Contrato no encontrado o no pertenece a tu empresa"
          }
        }
      },
      "delete": {
        "summary": "Desactivar enlace compartido",
        "description": "Desactiva el enlace compartido de un contrato.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Enlace desactivado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "No autorizado" },
          "404": {
            "description": "Contrato no encontrado o no pertenece a tu empresa"
          }
        }
      },
      "get": {
        "summary": "Obtener información del enlace compartido",
        "description": "Obtiene la información del enlace compartido de un contrato (solo para el dueño del contrato).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Información del enlace compartido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "shareEnabled": { "type": "boolean" },
                    "shareToken": { "type": "string", "nullable": true },
                    "shareUrl": {
                      "type": "string",
                      "format": "uri",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "No autorizado" },
          "404": {
            "description": "Contrato no encontrado o no pertenece a tu empresa"
          }
        }
      }
    },
    "/auditoria": {
      "get": {
        "summary": "Listar auditoría",
        "description": "Lista todos los registros de auditoría de la empresa del usuario autenticado.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "No autorizado" }
        }
      },
      "post": {
        "summary": "Registrar auditoría",
        "description": "Registra un nuevo evento en la auditoría. El usuario se obtiene del token JWT.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuditoriaCrear" }
            }
          }
        },
        "responses": {
          "201": { "description": "Creado" },
          "401": { "description": "No autorizado" }
        }
      }
    },
    "/empresas": {
      "get": {
        "summary": "Listar empresas",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "summary": "Crear empresa",
        "description": "Acepta dos formatos: formato simple (solo empresa) o formato completo (empresa con usuario). Si se envía usuario y empresa, crea automáticamente el usuario, la empresa y la relación empresa-usuario con rol administrador.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  { "$ref": "#/components/schemas/Empresa" },
                  { "$ref": "#/components/schemas/EmpresaConUsuario" }
                ]
              }
            }
          }
        },
        "responses": { "201": { "description": "Creado" } }
      }
    },
    "/empresas/{id}": {
      "get": {
        "summary": "Obtener empresa",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "responses": { "200": { "description": "OK" } }
      },
      "put": {
        "summary": "Actualizar empresa",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Empresa" }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "summary": "Eliminar empresa",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/roles": {
