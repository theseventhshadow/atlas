    "/empresa-usuarios": {
      "get": {
        "summary": "Listar vínculos empresa-usuarios",
        "description": "Lista todos los usuarios vinculados a la empresa del usuario autenticado, incluyendo sus roles.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "No autorizado" }
        }
      },
      "post": {
        "summary": "Crear vínculo",
        "description": "Crea un vínculo entre un usuario y la empresa del usuario autenticado. Puede crear un nuevo usuario o vincular uno existente.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "usuario_id": {
                    "type": "integer",
                    "description": "ID del usuario existente (opcional si se proporcionan datos del usuario)"
                  },
                  "rol_id": {
                    "type": "integer",
                    "description": "ID del rol a asignar"
                  },
                  "nombre_usuario": {
                    "type": "string",
                    "description": "Nombre de usuario (requerido si no se proporciona usuario_id)"
                  },
                  "contrasena_hash": {
                    "type": "string",
                    "description": "Contraseña hash (requerido si no se proporciona usuario_id)"
                  },
                  "correo": {
                    "type": "string",
                    "description": "Correo electrónico (requerido si no se proporciona usuario_id)"
                  }
                },
                "required": ["rol_id"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Creado" },
          "400": { "description": "Datos inválidos" },
          "401": { "description": "No autorizado" }
        }
      }
    },
    "/empresa-usuarios/{id}": {
      "get": {
        "summary": "Obtener vínculo",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Vínculo no encontrado" }
        }
      },
      "put": {
        "summary": "Actualizar vínculo",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": { "type": "integer" },
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EmpresaUsuario" }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Vínculo no encontrado" }
        }
      },
      "delete": {
