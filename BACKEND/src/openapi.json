              }
            }
          },
          "401": { "description": "No autorizado" }
        }
      }
    },
    "/public/contratos/{token}/verify": {
      "post": {
        "summary": "Verificar contraseña de contrato compartido",
        "description": "Endpoint público para verificar la contraseña y obtener información básica de un contrato compartido.",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "schema": { "type": "string" },
            "required": true,
            "description": "Token del contrato compartido"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "password": {
                    "type": "string",
                    "description": "Contraseña del contrato compartido"
                  }
                },
                "required": ["password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contraseña verificada correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer" },
                    "titulo": { "type": "string" },
                    "descripcion": { "type": "string", "nullable": true },
                    "fecha_inicio": { "type": "string", "format": "date" },
                    "fecha_fin": { "type": "string", "format": "date" },
                    "cliente_nombre": { "type": "string" },
                    "verified": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "400": { "description": "Contraseña requerida" },
          "401": { "description": "Contraseña incorrecta" },
          "403": { "description": "Enlace desactivado" },
          "404": { "description": "Contrato no encontrado" }
        }
      }
    },
    "/public/contratos/{token}/files": {
      "get": {
        "summary": "Listar archivos de contrato compartido",
        "description": "Endpoint público para listar los archivos de un contrato compartido. Requiere la contraseña como query parameter.",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "schema": { "type": "string" },
            "required": true,
            "description": "Token del contrato compartido"
          },
          {
            "in": "query",
            "name": "password",
            "schema": { "type": "string" },
            "required": true,
            "description": "Contraseña del contrato compartido"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de archivos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer" },
                      "nombre_archivo": { "type": "string" },
                      "created_at": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Contraseña requerida" },
          "401": { "description": "Contraseña incorrecta" },
          "403": { "description": "Enlace desactivado" },
          "404": { "description": "Contrato no encontrado" }
        }
      }
    },
    "/public/contratos/{token}/file/{fileId}": {
      "get": {
        "summary": "Descargar archivo de contrato compartido",
        "description": "Endpoint público para descargar un archivo específico de un contrato compartido. Requiere la contraseña como query parameter.",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "schema": { "type": "string" },
            "required": true,
            "description": "Token del contrato compartido"
          },
          {
            "in": "path",
            "name": "fileId",
            "schema": { "type": "integer" },
            "required": true,
            "description": "ID del archivo"
          },
          {
            "in": "query",
            "name": "password",
            "schema": { "type": "string" },
            "required": true,
            "description": "Contraseña del contrato compartido"
          }
        ],
        "responses": {
          "200": {
            "description": "Archivo PDF",
            "content": {
              "application/pdf": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "400": { "description": "Contraseña requerida" },
          "401": { "description": "Contraseña incorrecta" },
          "403": { "description": "Enlace desactivado" },
          "404": { "description": "Contrato o archivo no encontrado" }
        }
      }
    }
  },
  "components": {
    "schemas": {
