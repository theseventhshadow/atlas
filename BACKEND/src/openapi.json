            "type": "array",
            "items": { "type": "string", "format": "binary" },
            "description": "Hasta 10 archivos PDF"
          }
        },
        "required": [
          "cliente_id",
          "titulo",
          "fecha_inicio",
          "fecha_fin",
          "files"
        ]
